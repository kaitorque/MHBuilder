<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MHBuilder</RootNamespace>
    <AssemblyName>MHBuilder</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\data\skills.json" Link="data\skills.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\armor.json" Link="data\armor.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\decorations.json" Link="data\decorations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\charms.json" Link="data\charms.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\weapons.json" Link="data\weapons.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\materials.json" Link="data\materials.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\monsters.json" Link="data\monsters.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\SOURCE.json" Link="data\SOURCE.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MHBuilder.Tests" />
  </ItemGroup>
</Project>
